# Copy to backend/.env (git-ignored) or set these as environment variables on your host. NEVER commit real values.
SECRET_KEY=generate-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

FRONTEND_URL=https://jrlearners.com
PUBLIC_API_URL=https://api.your-host.example          # public URL of THIS backend (PayU posts the customer back here)
CORS_ORIGINS=https://jrlearners.com

# PayU dashboard -> Payment Gateway -> Key Salt Details
PAYU_ENV=test                                         # test | live
PAYU_KEY=
PAYU_SALT=
# Only needed for the payment-links / split-payment APIs
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
