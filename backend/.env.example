# Copy to backend/.env (git-ignored) or set these as environment variables on your host. NEVER commit real values.
SECRET_KEY=generate-a-long-random-string
ADMIN_EMAIL=you@example.com                          # the administrator account is created from these two at start-up
ADMIN_PASSWORD=choose-a-strong-password-with-a-digit

FRONTEND_URL=https://jrlearners.com
PUBLIC_API_URL=https://api.jrlearners.com             # public URL of THIS backend (PayU posts the customer back here)
CORS_ORIGINS=https://jrlearners.com

# PayU dashboard -> Payment Gateway -> Key Salt Details
PAYU_ENV=test                                         # test | live
PAYU_KEY=
PAYU_SALT=
# Only needed for the payment-links / split-payment APIs
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=

# E-mail: every registration, order, contact form and quote request goes to ADMIN_NOTIFY_EMAIL
ADMIN_NOTIFY_EMAIL=admin@jrlearners.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls                                # starttls | ssl | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@jrlearners.com
TRUST_PROXY=1                                         # behind Caddy / nginx: read the client IP from X-Forwarded-For
